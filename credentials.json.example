{
    "_comment": "Copy to credentials.json. Alpha Vantage keys rotate through this list (rate limits are IP-level, so multiple keys mainly help with transient failures). Used by core/alphavantage_api.py / tools/news_sentiment.py.",
    "alphavantage_api_keys": [
        "YOUR_ALPHA_VANTAGE_KEY_1",
        "YOUR_ALPHA_VANTAGE_KEY_2"
    ],
    "twitter_api": {
        "_comment": "X/Twitter OAuth 1.0a User Context for @ThePrintFlow. IMPORTANT: set App permissions to Read+Write in the X Developer Portal BEFORE generating the access token pair - tokens minted under Read-only are permanently read-only and posting will 403. bearer_token is stored but unused for posting.",
        "api_key": "YOUR_X_CONSUMER_KEY",
        "api_key_secret": "YOUR_X_CONSUMER_KEY_SECRET",
        "access_token": "YOUR_X_ACCESS_TOKEN",
        "access_token_secret": "YOUR_X_ACCESS_TOKEN_SECRET",
        "bearer_token": "YOUR_X_BEARER_TOKEN"
    }
}
