      """Execute FM Agent for today's alerts"""
      try:
          from strategies.flow_monitor.fm_agent import FMAgent

          agent = FMAgent()
          today = now_eastern().strftime('%Y-%m-%d')
          result = agent.analyze_todays_alerts(today)

          return result.get('success', False)

      except Exception as e:
          logging.error("FM Agent error: {}".format(e))
          return False

  fm_agent.py (FM-Specific Wrapper)

  #!/usr/bin/env python3
  """
  Flow Monitor Agent - FM-Specific Wrapper (fm_agent.py)
  ------------------------------------------------------
  FM-specific context and orchestration for the agent runtime.
  Calls the core agent_runtime with FM prompts and tools.

  Created: 2025-12-31
  Author: Ben (with assistance from Claude)
  """

  import logging
  from datetime import datetime
  from pathlib import Path

  # Import core agent framework
  import sys
  project_root = Path(__file__).parent.parent.parent
  sys.path.insert(0, str(project_root / 'agents'))

  from agent_runtime import AgentRuntime
  from agent_tools import AgentTools
  from agent_prompts import FM_AGENT_SYSTEM_PROMPT
  from strategies.flow_monitor.fm_config import FMConfig
  from strategies.flow_monitor.fm_storage import FlowMonitorStorage
  from tools.timezone_utils import now_eastern, eastern_isoformat

  class FMAgent:
      """Flow Monitor Agent - tracks and analyzes flow alerts"""

      def __init__(self):
          """Initialize FM Agent with config and runtime"""
          self.config = FMConfig()
          self.storage = FlowMonitorStorage(self.config)

          # Initialize agent tools (database access, tracker operations)
          self.tools = AgentTools(self.storage)

          # Initialize agent runtime (Anthropic SDK)
          self.runtime = AgentRuntime(
              system_prompt=FM_AGENT_SYSTEM_PROMPT,
              tools=self.tools.get_tool_definitions(),
              tool_executor=self.tools.execute_tool
          )

          logging.info("FM Agent initialized")

      def analyze_todays_alerts(self, trade_date):
          """Analyze all alerts from today

          Args:
              trade_date: Date string (YYYY-MM-DD)

          Returns:
              dict: Results summary
          """
          logging.info("FM Agent analyzing alerts for {}".format(trade_date))

          # Get today's alerts
          alerts = self._get_todays_alerts(trade_date)

          if not alerts:
              logging.info("No alerts to analyze")
              return {'success': True, 'alerts_processed': 0}

          logging.info("Processing {} alerts".format(len(alerts)))

          results = {
              'success': True,
              'alerts_processed': len(alerts),
              'trackers_created': 0,
              'trackers_updated': 0,
              'trackers_closed': 0,
              'errors': 0
          }

          # Process each alert
          for alert in alerts:
              try:
                  result = self._process_alert(alert)

                  if result['action'] == 'created':
                      results['trackers_created'] += 1
                  elif result['action'] == 'updated':
                      results['trackers_updated'] += 1
                  elif result['action'] == 'closed':
                      results['trackers_closed'] += 1

              except Exception as e:
                  logging.error("Error processing alert {}: {}".format(alert.get('id'), e))
                  results['errors'] += 1

          logging.info("FM Agent completed: {} created, {} updated, {} closed".format(
              results['trackers_created'],
              results['trackers_updated'],
              results['trackers_closed']
          ))

          return results

      def _get_todays_alerts(self, trade_date):
          """Get all alerts from today"""
          query = """
              SELECT
                  id, contract_hash, symbol, strike, expiration_date, option_type,
                  significance_score, volume, open_interest, premium_value,
                  underlying_price, iv, delta, dte, alert_timestamp, alert_reason
              FROM flow_alerts
              WHERE trade_date = ?
              ORDER BY alert_timestamp
          """

          results = self.storage.query_with_params(query, (trade_date,))
          return results if results else []

      def _process_alert(self, alert):
          """Process single alert - create or update tracker

          Args:
              alert: Alert dictionary

          Returns:
              dict: Action taken
          """
          contract_hash = alert['contract_hash']

          # Build user prompt for this alert
          user_prompt = self._build_alert_prompt(alert)

          # Call agent runtime
          response = self.runtime.run(user_prompt)

          # Log agent's work
          self._log_agent_work(alert, response)

          # Determine what action was taken
          # (Agent used tools like create_tracker, update_tracker, etc.)
          # Parse from response or track in runtime

          return {
              'action': 'created',  # or 'updated' or 'closed'
              'tracker_id': response.get('tracker_id')
          }

      def _build_alert_prompt(self, alert):
          """Build user prompt for analyzing this alert"""
          return """New flow alert detected:

  Symbol: {symbol}
  Contract: ${strike} {option_type}s exp {expiration}
  Significance Score: {score}
  Premium: ${premium:,.0f}
  Volume: {volume:,}
  Open Interest: {oi:,}
  DTE: {dte}

  Alert reason: {reason}

  Task:
  1. Check if tracker already exists for this contract
  2. If exists: Update with this new alert, evolve the narrative
  3. If new: Create tracker with initial narrative

  Build a clear narrative explaining:
  - What this flow looks like (institutional? hedge? speculative?)
  - Context (earnings coming? sector movement? market conditions?)
  - How confident are you in your read?
  - What might the traders behind this be thinking?

  Remember: Be direct, honest, speculative but labeled. This is day 1 of tracking this contract.
  """.format(
              symbol=alert['symbol'],
              strike=alert['strike'],
              option_type=alert['option_type'],
              expiration=alert['expiration_date'],
              score=alert['significance_score'],
              premium=alert.get('premium_value', 0),
              volume=alert.get('volume', 0),
              oi=alert.get('open_interest', 0),
              dte=alert.get('dte', 0),
              reason=alert.get('alert_reason', 'N/A')
          )

      def _log_agent_work(self, alert, response):
          """Log agent's analysis to file"""
          log_dir = Path("logs/agent_sessions")
          log_dir.mkdir(parents=True, exist_ok=True)

          today = now_eastern().strftime('%Y-%m-%d')
          log_file = log_dir / f"fm_agent_{today}.md"

          with open(log_file, 'a', encoding='utf-8') as f:
              f.write(f"\n## Alert: {alert['symbol']} ${alert['strike']} {alert['option_type']}s\n")
              f.write(f"Timestamp: {eastern_isoformat()}\n")
              f.write(f"Significance: {alert['significance_score']}\n\n")
              f.write("### Agent Response:\n")
              f.write(response.get('content', 'No response') + "\n")
              f.write("\n---\n")

  Validation Workflow (Phase 1)

  After 1 week of running:

  -- Check tracker creation
  SELECT
      status,
      COUNT(*) as count,
      AVG(confidence_level) as avg_confidence
  FROM flow_contract_trackers
  GROUP BY status;

  -- Read some narratives
  SELECT
      symbol,
      strike,
      option_type,
      expiration,
      days_active,
      narrative
  FROM flow_contract_trackers
  WHERE status = 'active'
  ORDER BY created_at DESC
  LIMIT 10;

  -- Check update frequency
  SELECT
      tracker_id,
      COUNT(*) as update_count,
      MAX(update_timestamp) as last_update
  FROM flow_tracker_updates
  GROUP BY tracker_id
  ORDER BY update_count DESC;

  Validation questions:
  1. Are the narratives coherent and readable?
  2. Can you understand what's happening with each contract?
  3. Is the agent making reasonable interpretations?
  4. Are trackers being closed appropriately?
  5. Is the casual analyst tone working?

